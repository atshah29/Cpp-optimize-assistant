# Keep the provider account on its Free plan. The app cannot enforce account billing settings.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TEMPERATURE=0.2
# Docker is the default. Native is an explicit opt-in for trusted code only.
OPTIMIZER_RUNNER=docker
OPTIMIZER_IMAGE=cpp-optimizer-runner:local
# OPTIMIZER_JOB_DIR=/absolute/path/to/local/job-storage
