      "diff": "--- a/sieve.cpp\n+++ b/sieve.cpp\n@@ -2,25 +2,27 @@\n #include <vector>\n #include <list>\n #include <cstdlib>\n+#include <algorithm>\n \n using namespace std;\n \n void sieve(list<int>& unknown, vector<int>& primes)\n {\n-  while (!unknown.empty())\n-  {\n-    int p = unknown.front();\n-    unknown.pop_front();\n-    list<int>::iterator i = unknown.begin();\n-    while (i != unknown.end())\n-    {\n-      if (*i % p)\n-        ++i;\n-      else\n-        i = unknown.erase(i);\n+  if (unknown.empty()) return;\n+  int max_val = *max_element(unknown.begin(), unknown.end());\n+  vector<char> is_prime(max_val + 1, true);\n+  if (max_val >= 0) is_prime[0] = false;\n+  if (max_val >= 1) is_prime[1] = false;\n+  for (int p = 2; p * p <= max_val; ++p) {\n+    if (is_prime[p]) {\n+      for (int mult = p * p; mult <= max_val; mult += p)\n+        is_prime[mult] = false;\n     }\n-    primes.push_back(p);\n   }\n+  for (int v : unknown) {\n+    if (is_prime[v]) primes.push_back(v);\n+  }\n+  unknown.clear();\n }\n \n int main(int argc, char *argv[]) \n",
