      "diff": "--- a/kernel.cpp\n+++ b/kernel.cpp\n@@ -1,8 +1,24 @@\n #include \"common.hpp\"\n+#include <utility>\n std::uint64_t kernel(std::uint32_t n, std::uint32_t seed) {\n     auto values = make_data(n, seed);\n+    // Pair each value with its original index to preserve the original insertion order for equal keys\n+    std::vector<std::pair<std::uint32_t, std::uint32_t>> paired;\n+    paired.reserve(n);\n+    for (std::uint32_t i = 0; i < n; ++i) {\n+        paired.emplace_back(values[i], i);\n+    }\n+    // Sort by value ascending; for equal values, later original indices come first (reverse order)\n+    std::sort(paired.begin(), paired.end(),\n+              [](const auto& a, const auto& b) {\n+                  if (a.first != b.first) return a.first < b.first;\n+                  return a.second > b.second;\n+              });\n     std::vector<std::uint32_t> sorted;\n-    for (auto value : values) sorted.insert(std::lower_bound(sorted.begin(), sorted.end(), value), value);\n+    sorted.reserve(n);\n+    for (auto& p : paired) {\n+        sorted.push_back(p.first);\n+    }\n     std::uint64_t result = 0;\n     for (unsigned i = 0; i < n; ++i) result += std::uint64_t(i + 1) * sorted[i];\n     return result;\n",
