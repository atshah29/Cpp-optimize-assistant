      "diff": "--- a/kernel.cpp\n+++ b/kernel.cpp\n@@ -1,11 +1,23 @@\n #include \"common.hpp\"\n std::uint64_t kernel(std::uint32_t n, std::uint32_t seed) {\n-    auto values = make_data(n, seed);\n-    std::string text;\n-    for (auto value : values) text.push_back(char('a' + value % 4));\n     std::uint64_t result = 0;\n-    for (unsigned i = 0; i + 4 <= text.size(); ++i)\n-        if (text.substr(i, 4) == \"abcd\") result++;\n+    char window[4];\n+    std::size_t wsize = 0;\n+    for (std::uint32_t i = 0; i < n; ++i) {\n+        seed = seed * 1664525u + 1013904223u;\n+        std::uint32_t value = (seed >> 16) % 1000;\n+        char c = static_cast<char>('a' + (value % 4));\n+        if (wsize < 4) {\n+            window[wsize++] = c;\n+            if (wsize == 4 && std::equal(window, window + 4, \"abcd\")) ++result;\n+        } else {\n+            window[0] = window[1];\n+            window[1] = window[2];\n+            window[2] = window[3];\n+            window[3] = c;\n+            if (std::equal(window, window + 4, \"abcd\")) ++result;\n+        }\n+    }\n     return result;\n }\n \n",
